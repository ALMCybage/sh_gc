########################################################################
# Stateless Core Web API (PHP Laravel 9)
########################################################################
APP_NAME="Sequifi Web API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Cloud Logging picks up structured JSON from stdout/stderr.
LOG_CHANNEL=stderr
LOG_LEVEL=debug
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

########################################################################
# Cloud SQL for MySQL
# In GKE the Cloud SQL Auth Proxy runs as a sidecar, so the app always
# talks to 127.0.0.1:3306 and never handles a DB password over the wire.
########################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tenant_acme
DB_USERNAME=app
DB_PASSWORD=secret

########################################################################
# Multi-tenancy
########################################################################
TENANCY_HEADER=X-Tenant
# Comma-separated. "acme.sequifi.com" and "acme.localhost:5173" both -> "acme".
TENANCY_BASE_DOMAINS=sequifi.com,localhost
TENANCY_SCHEMA_PREFIX=tenant_
TENANCY_FALLBACK_TENANT=acme
# NEVER true outside local development. The header is client-supplied; trusting it
# lets a caller aim a request at another tenant's schema. Force-disabled when
# APP_ENV=production regardless of this value.
TENANCY_TRUST_HEADER=false
# Optional: replace the static registry in config/tenancy.php
# TENANTS_JSON={"acme":{"name":"Acme","database":"tenant_acme","domain":"acme.sequifi.com"}}

RATE_LIMIT_PER_TENANT=600
RATE_LIMIT_PER_CLIENT=120

########################################################################
# Memorystore (Redis) - sessions + app cache, keeps web pods stateless
########################################################################
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=sync
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

########################################################################
# SPA session auth (Sanctum)
# SESSION_DOMAIN stays null so cookies are host-only and one tenant's
# session can never be presented to another tenant's hostname.
########################################################################
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS="*.sequifi.com,*.localhost:5173"

########################################################################
# Google Cloud
########################################################################
GOOGLE_CLOUD_PROJECT=my-gcp-project

# rest = real Pub/Sub or the emulator | log = write envelope to the log only
PUBSUB_DRIVER=rest
PUBSUB_TOPIC_PAYROLL=payroll-calc-events
PUBSUB_TOPIC_SALES=sales-import
# Local emulator only. Leave empty in GKE (Workload Identity supplies creds).
PUBSUB_EMULATOR_HOST=localhost:8085

# rest = Firestore | cache = Redis/file fallback (PHP only) | null = disabled
FIRESTORE_DRIVER=rest
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=api_request_statuses
FIRESTORE_EMULATOR_HOST=localhost:8086
